<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup/transfer rules. WiFi history contains network names, which we
     promise never leave the device — so exclude it from cloud backup. Direct
     device-to-device transfer (user-initiated, no cloud) keeps everything. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
